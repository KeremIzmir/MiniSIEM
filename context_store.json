{
  "parser/events.py": {
    "classlar": ["EventType(StrEnum)", "Event(timestamp, host, process, event_type, username, source_ip, port, raw_line)"],
    "metodlar": ["Event.to_dict() -> dict", "Event.is_failure -> bool", "Event.is_success -> bool"]
  },
  "detection/alert.py": {
    "classlar": ["Severity(StrEnum: low/medium/high, .rank)", "Alert(rule_name, severity, source_ip, count, time_window, description, evidence)"],
    "metodlar": ["Alert.to_dict() -> dict"]
  },
  "parser/auth_parser.py": {
    "fonksiyonlar": [
      "parse_line(line, reference_year=None, now=None) -> Optional[Event]",
      "parse_lines(lines, ...) -> tuple[list[Event], list[str]]",
      "parse_file(path, ...) -> tuple[list[Event], list[str]]"
    ]
  },
  "storage/store.py": {
    "classlar": ["EventStore"],
    "metodlar": [
      "add_event(e)", "add_events(list)", "add_alert(obj)",
      "events", "alerts", "failed_events() -> list[Event]",
      "unique_ips() -> set[str]", "top_ips(limit=10) -> list[tuple[str,int]]",
      "failed_per_minute() -> list[tuple[str,int]]", "summary() -> dict",
      "to_json(path=None) -> str", "unparsed_count: int"
    ]
  },
  "detection/brute_force.py": {"fonksiyonlar": ["detect_brute_force(events, window=300, threshold=5) -> list[Alert]"]},
  "detection/enumeration.py": {"fonksiyonlar": ["detect_enumeration(events, threshold=5) -> list[Alert]"]},
  "detection/fail_then_success.py": {"fonksiyonlar": ["detect_fail_then_success(events, min_fails=3, window=600) -> list[Alert]"]},
  "detection/anomaly.py": {"fonksiyonlar": ["is_public_ip(ip) -> bool", "detect_anomalous_ips(events, k=2.0, min_volume=5) -> list[Alert]"]},
  "detection/engine.py": {"fonksiyonlar": ["run_detections(events, window=300, threshold=5, enum_threshold=5, allowlist=None) -> list[Alert]"]},
  "cli.py": {"fonksiyonlar": ["build_parser() -> ArgumentParser", "run(argv=None, out=stdout) -> int", "main()"]},
  "dashboard/app.py": {
    "fonksiyonlar": [
      "build_store(logfile, window=300, threshold=5, enum_threshold=5, allowlist=None) -> EventStore",
      "create_app(store) -> Flask", "main()"
    ],
    "rotalar": ["/", "/api/summary", "/api/alerts", "/api/timeline"]
  }
}
